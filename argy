<script>
(function(){
// ---- piano flussi (per 100 di nominale emesso) ----
var DATES=["2027-03-31","2027-09-30","2028-03-31","2028-10-02","2029-04-02","2029-10-01","2030-04-01","2030-09-30","2031-03-31","2031-09-30","2032-03-31","2032-09-30","2033-03-31","2033-09-30","2034-03-31","2034-10-02","2035-04-02","2035-10-01","2036-03-31","2036-09-30","2037-03-31","2037-09-30","2038-03-31","2038-09-30","2038-12-31"];
function ms(s){var p=s.split("-");return Date.UTC(+p[0],+p[1]-1,+p[2]);}
var ROWS=(function(){
  var res=100,prevRate=3.38,out=[];
  for(var i=0;i<DATES.length;i++){
    var am=i>=5?5:0, fr=i===DATES.length-1?0.25:0.5;
    var cp=res*prevRate/100*fr, after=res-am;
    out.push({iso:DATES[i],t:ms(DATES[i]),flow:am+cp,res:after});
    prevRate=i>=4?4.74:3.38; res=after;
  }
  return out;
})();
var MIN=ms("2026-10-01"),MAX=ms(DATES[DATES.length-1]);

function num(s){return parseFloat(String(s).replace(/\s/g,"").replace(",","."));}
function f(x,d){return x.toLocaleString("it-IT",{minimumFractionDigits:d,maximumFractionDigits:d});}
function itd(iso){var p=iso.split("-");return p[2]+"/"+p[1]+"/"+p[0];}
function $(id){return document.getElementById("px"+id);}

function setup(v){
  var resid=100;
  ROWS.forEach(function(r){if(r.t<=v)resid=r.res;});
  var fut=ROWS.filter(function(r){return r.t>v;});
  return {resid:resid,coef:resid/100,fut:fut};
}
function pv(fut,v,y){var s=0;fut.forEach(function(r){s+=r.flow/Math.pow(1+y,(r.t-v)/86400000/365);});return s;}
function solve(fut,v,dirty){
  var lo=-0.95,hi=20,g=function(y){return pv(fut,v,y)-dirty;};
  if(g(lo)*g(hi)>0)return NaN;
  for(var i=0;i<200;i++){var m=(lo+hi)/2;if(g(lo)*g(m)<=0)hi=m;else lo=m;}
  return (lo+hi)/2;
}
function dur(fut,v,y){
  var a=0,b=0;fut.forEach(function(r){var t=(r.t-v)/86400000/365,p=r.flow/Math.pow(1+y,t);a+=t*p;b+=p;});
  var mac=a/b;return {mac:mac,mod:mac/(1+y)};
}
function table(el,fut,v,y){
  var h="<tr><th>Data</th><th>Flusso</th><th>t (anni)</th><th>Val. attuale</th></tr>";
  ROWS.forEach(function(r){
    if(r.t>v){var t=(r.t-v)/86400000/365;h+="<tr><td>"+itd(r.iso)+"</td><td>"+f(r.flow,4)+"</td><td>"+f(t,4)+"</td><td>"+(isNaN(y)?"–":f(r.flow/Math.pow(1+y,t),4))+"</td></tr>";}
    else h+='<tr class="x"><td>'+itd(r.iso)+"</td><td>"+f(r.flow,4)+"</td><td>–</td><td>–</td></tr>";
  });
  el.innerHTML=h;
}
function clear(ids){ids.forEach(function(i){$(i).textContent="–";});}
function checkDate(iso,m){
  var v=ms(iso||"");
  if(!iso||isNaN(v)){m.textContent="Inserire una data valida.";return NaN;}
  if(v<MIN||v>MAX){m.textContent="Data fuori intervallo: ammessa dal 01/10/2026 al 31/12/2038.";return NaN;}
  return v;
}
function show(k,s,v){
  $("rs"+k).textContent=f(s.resid,2);$("cf"+k).textContent=f(s.coef,4);$("n"+k).textContent=s.fut.length;
}

function calc1(){
  var m=$("m1");m.textContent="";clear(["y1","md1","mc1","rs1","cf1","po1","n1"]);$("tb1").innerHTML="";
  var v=checkDate($("d1").value,m);if(isNaN(v))return;
  var p=num($("pr").value);
  if(!(p>0)){m.textContent="Inserire un prezzo maggiore di zero.";return;}
  var s=setup(v);show(1,s,v);
  if(s.fut.length===0){m.textContent="Alla scadenza non restano flussi: rendimento non calcolabile.";return;}
  var dirty=$("bs").value==="res"?p*s.coef:p;
  $("po1").textContent=f(dirty,4);
  var y=solve(s.fut,v,dirty);
  if(isNaN(y)){m.textContent="Rendimento non determinabile con questo prezzo.";table($("tb1"),s.fut,v,NaN);return;}
  var d=dur(s.fut,v,y);
  $("y1").textContent=f(y*100,3)+"%";$("md1").textContent=f(d.mod,3);$("mc1").textContent=f(d.mac,3);
  table($("tb1"),s.fut,v,y);
}
function calc2(){
  var m=$("m2");m.textContent="";clear(["pp2","md2","mc2","rs2","cf2","po2","n2"]);$("tb2").innerHTML="";
  var v=checkDate($("d2").value,m);if(isNaN(v))return;
  var y=num($("yi").value)/100;
  if(isNaN(y)||y<=-0.95){m.textContent="Inserire un rendimento valido (maggiore di -95%).";return;}
  var s=setup(v);show(2,s,v);
  if(s.fut.length===0){m.textContent="Alla scadenza non restano flussi da attualizzare.";return;}
  var orig=pv(s.fut,v,y),d=dur(s.fut,v,y);
  $("po2").textContent=f(orig,4);$("pp2").textContent=f(orig/s.coef,4);
  $("md2").textContent=f(d.mod,3);$("mc2").textContent=f(d.mac,3);
  table($("tb2"),s.fut,v,y);
}
["d1","pr","bs"].forEach(function(i){$(i).addEventListener("input",calc1);$(i).addEventListener("change",calc1);});
