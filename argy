["d2","yi"].forEach(function(i){$(i).addEventListener("input",calc2);$(i).addEventListener("change",calc2);});
function xirr(cf){
  var t0=cf[0].t,g=function(y){var s=0;cf.forEach(function(c){s+=c.v/Math.pow(1+y,(c.t-t0)/86400000/365);});return s;};
  var lo=-0.99,hi=1000;if(g(lo)*g(hi)>0)return NaN;
  for(var i=0;i<300;i++){var m=(lo+hi)/2;if(g(lo)*g(m)<=0)hi=m;else lo=m;}
  return (lo+hi)/2;
}
function calc3(){
  var m=$("m3");m.textContent="";clear(["ti3","ox3","ri3","fl3","ne3","cp3","ca3","tr3","gg3","cf3"]);$("tb3").innerHTML="";
  var vb=checkDate($("d3").value,m);if(isNaN(vb))return;
  var pa=num($("pa").value);if(!(pa>0)){m.textContent="Inserire un prezzo di acquisto maggiore di zero.";return;}
  var vs=ms($("e3").value||"");
  if(isNaN(vs)){m.textContent="Inserire una data di vendita valida.";return;}
  if(vs<vb||vs>MAX){m.textContent="La vendita deve essere compresa tra la data di acquisto e la scadenza.";return;}
  var ps=num($("ps").value);if(!(ps>0)){m.textContent="Inserire un prezzo di vendita maggiore di zero.";return;}
  var N=num($("nm").value);if(!(N>0)){m.textContent="Inserire un nominale maggiore di zero.";return;}
  var sb=setup(vb),ss=setup(vs);
  if(sb.coef<=0){m.textContent="Alla scadenza non è più possibile acquistare.";return;}
  var no=N/sb.coef,out=pa/100*N,cp=0,ca=0,cf=[{t:vb,v:-out}];
  var h="<tr><th>Data</th><th>Flusso (100 emessi)</th><th>Cedole</th><th>Capitale</th></tr>";
  ROWS.forEach(function(r,i){
    var prev=i?ROWS[i-1].res:100,am=prev-r.res,it=r.flow-am,k=no/100;
    if(r.t>vb&&r.t<=vs){cp+=it*k;ca+=am*k;cf.push({t:r.t,v:r.flow*k});
      h+="<tr><td>"+itd(r.iso)+"</td><td>"+f(r.flow,4)+"</td><td>"+f(it*k,2)+"</td><td>"+f(am*k,2)+"</td></tr>";}
    else h+='<tr class="x"><td>'+itd(r.iso)+"</td><td>"+f(r.flow,4)+"</td><td>–</td><td>–</td></tr>";
  });
  var ric=ps/100*no*ss.coef;cf.push({t:vs,v:ric});
  var net=cp+ca+ric-out,y=vs>vb?xirr(cf):NaN;
  $("ti3").textContent=isNaN(y)?"n.d.":f(y*100,3)+"%";
  $("ox3").textContent=f(out,2);$("ri3").textContent=f(ric,2);$("fl3").textContent=f(cp+ca,2);$("ne3").textContent=f(net,2);
  $("cp3").textContent=f(cp,2);$("ca3").textContent=f(ca,2);$("tr3").textContent=f(net/out*100,2)+"%";
  $("gg3").textContent=Math.round((vs-vb)/86400000);$("cf3").textContent=f(sb.coef,4)+" / "+f(ss.coef,4);
  $("tb3").innerHTML=h;
}
